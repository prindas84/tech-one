@page "/"
@rendermode InteractiveServer

<head>
    <title>TechnologyOne Technical Test: Matthew Prendergast (m@tthew.info)</title>
</head>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">

            <h3 class="mb-3">Dollar Amount Input</h3>
            
            <div class="mb-3">
                <label for="dollarInput" class="form-label mb-2">Enter Dollar Amount</label>
                <input type="text" 
                    class="form-control @(isValid ? "" : "is-invalid")" 
                    id="dollarInput" 
                    @bind="inputValue" 
                    @bind:event="oninput"
                    placeholder="123456.78 or 123456"
                    maxlength="18" />
                <p class="small text-muted mt-2">Format: dddddd.dd or dddddd<br>Range: 0 &le; n &lt; 1000000000000000.00</p>
                
                @if (!isValid && !string.IsNullOrEmpty(errorMessage))
                {
                    <div class="invalid-feedback">
                        @errorMessage
                    </div>
                }
            </div>
            
            <div class="d-flex gap-2">
                <button type="button" 
                        class="btn btn-primary" 
                        @onclick="ConvertValue">
                    Convert
                </button>
                
                <button type="button" 
                        class="btn btn-warning" 
                        @onclick="ClearPage">
                    Clear
                </button>
            </div>

        </div>

        <div class="mt-5">
            @if (!string.IsNullOrEmpty(convertedString))
            {
                <div class="alert alert-info mt-3">
                    <h5>Word Conversion:</h5>
                    <p class="mb-0"><strong>@convertedString</strong></p>
                </div>
            }
        </div>
    </div>
</div>

